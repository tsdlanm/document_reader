<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark chrome, following the system setting. -->
    <style name="BaseTheme" parent="android:Theme.Material">
        <item name="android:colorPrimary">@color/bar</item>
        <item name="android:colorPrimaryDark">@color/bar</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlNormal">@color/bar_text</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:actionBarStyle">@style/Bar</item>
        <item name="android:actionMenuTextColor">@color/bar_text</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Bar" parent="android:Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/bar</item>
        <item name="android:elevation">2dp</item>
        <item name="android:titleTextStyle">@style/BarTitle</item>
        <item name="android:subtitleTextStyle">@style/BarSubtitle</item>
    </style>
</resources>